{
  "manifest_version": 3,
  "minimum_chrome_version": "120",
  "name": "Better X",
  "version": "0.1.0",
  "description": "Privacy, sharing, and appearance controls for X.",
  "permissions": [
    "storage"
  ],
  "icons": {
    "16": "icons/16.png",
    "32": "icons/32.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },
  "action": {
    "default_title": "Better X",
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": [
        "https://x.com/*",
        "https://twitter.com/*"
      ],
      "js": [
        "settings.js",
        "content.js",
        "quiet.js"
      ],
      "css": [
        "content.css",
        "navigation.css",
        "quiet.css"
      ],
      "run_at": "document_start"
    }
  ]
}
