{
  "manifest_version": 3,
  "minimum_chrome_version": "120",
  "name": "Better X",
  "version": "0.1.0",
  "description": "Privacy, sharing, and appearance controls for X.",
  "permissions": [
    "storage",
    "clipboardWrite",
    "contextMenus",
    "offscreen",
    "declarativeNetRequest",
    "downloads"
  ],
  "icons": {
    "16": "icons/16.png",
    "32": "icons/32.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },
  "action": {
    "default_title": "Better X",
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": [
        "https://x.com/*",
        "https://twitter.com/*"
      ],
      "js": [
        "page.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "https://x.com/*",
        "https://twitter.com/*"
      ],
      "js": [
        "settings.js",
        "content.js",
        "media.js",
        "quiet.js",
        "post-image.js",
        "share.js"
      ],
      "css": [
        "content.css",
        "navigation.css",
        "quiet.css",
        "share.css",
        "ads.css",
        "media.css"
      ],
      "run_at": "document_start"
    }
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"
  },
  "background": {
    "service_worker": "background.js"
  },
  "declarative_net_request": {
    "rule_resources": [
      {
        "id": "telemetry",
        "enabled": true,
        "path": "telemetry.json"
      }
    ]
  }
}
